#cloud-config
# Default first-boot configuration, read by cloud-init (NoCloud) from this
# FAT partition. Raspberry Pi Imager overwrites this file with your own
# hostname / user / SSH settings when you customize the flash; you can also
# edit it by hand from any computer before the first boot.
# Syntax: https://cloudinit.readthedocs.io/en/latest/reference/examples.html
# WiFi and static addresses go in network-config next to this file.

hostname: smartpi1
ssh_pwauth: true

# Default logins: pi / yumi and root / yumi — change them after the first login.
users:
  - name: pi
    gecos: SmartPi user
    shell: /bin/bash
    groups: [sudo, users, adm, dialout, audio, video, plugdev, netdev, i2c, spi, gpio]
    sudo: ALL=(ALL:ALL) ALL
    lock_passwd: false
    hashed_passwd: $6$yumismartpi$jdw9xlFZZjOwr0bXL3nogs5OFVSODSJxX2TGo8.aGDuUG86coPkvAXK4.XUODL0koioEWRnDYF0KUMu6JsSrS1
chpasswd:
  expire: false
