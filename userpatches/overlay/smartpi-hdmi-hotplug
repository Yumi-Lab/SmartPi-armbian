#!/bin/sh
# Called on every HDMI hotplug (udev, 90-smartpi-hdmi-hotplug.rules): puts a
# screen that tells its native mode (EDID) on that mode, switching it back on if
# it was left off. X switches the screen off when it finds no monitor at start,
# or sets a fallback mode when the screen's EDID arrives late, and nothing fixes
# it afterwards: a screen switched off and on, or the half second the H3 HDMI
# drops its hotplug line each time an X server starts (end of the first-boot
# wizard, log out, switch user). A screen that gives no EDID is left as X set
# it, only switched back on if it was off: a guessed mode would only move the
# windows already laid out under it.
# Every X server of the display manager is checked: switching user starts a
# second one.
for auth in /run/lightdm/root/:*; do
    [ -e "$auth" ] || continue
    export DISPLAY="${auth##*/}" XAUTHORITY="$auth"
    # outputs left off, and outputs with a preferred mode (+, from the EDID) not in use (*)
    xrandr | awk '/ connected/ {out = $1; if ($0 ~ / connected (primary )?\(/) {print out; out = ""}}
                  /^ / && /\+/ && !/\*/ && out {print out; out = ""}' |
        while read -r output; do
            xrandr --output "$output" --auto
        done
done
