def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def backdrop(width, height):
    """Screen-sized blurred wallpaper of this image as a PNG path, or None (the CSS gradient stays)."""
    blurred = None
    for conf in ("/etc/lightdm/slick-greeter.conf", "/etc/lightdm/lightdm-gtk-greeter.conf"):
        try:
            m = re.search(r"^background\s*=\s*(\S+)", open(conf).read(), re.M)
        except OSError:
            continue
        if m and m.group(1).startswith("/"):
            blurred = m.group(1); break
    try:
        if blurred:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(blurred, width, height, False)
        else:
            src = sorted(glob.glob("/usr/share/backgrounds/armbian/*"))[0]
            small = GdkPixbuf.Pixbuf.new_from_file_at_scale(src, 48, 27, False)   # shrink then enlarge = blur
            pix = small.scale_simple(width, height, GdkPixbuf.InterpType.BILINEAR)
        out = "/tmp/smartpi-firstboot-backdrop.png"
        pix.savev(out, "png", [], [])
        return out
    except Exception:
        return None


def board_wordmark():
    """Wordmark of the board this runs on, from its device tree: "yumi,smartpi-one" -> smartpi-one.svg,
    "yumi,smartpi-4" -> smartpi-4.svg (assets copied from the yumi-brand wordmarks, dark variant). None if unknown."""
    try:
        first = open("/proc/device-tree/compatible").read().split("\0")[0]
    except OSError:
        return None
    m = re.match(r"yumi,(smartpi-[a-z0-9]+)$", first)
    path = f"{ASSETS}/{m.group(1)}.svg" if m else None
    return path if path and os.path.exists(path) else None


def pixbuf(path, height):
    try:
        return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, -1, height, True)
    except Exception:
        return None


def emphasis(text):
    """*value* in bold Yumi yellow, the rest as plain text."""
    return re.sub(r"\*([^*]+)\*", lambda m: f'<span foreground="{YELLOW}" weight="bold">{m.group(1)}</span>',
                  GLib.markup_escape_text(text))


def label(text, cls, wrap=False, chars=46):
    l = Gtk.Label(label=text, xalign=0.5); l.get_style_context().add_class(cls)
    l.set_line_wrap(wrap); l.set_justify(Gtk.Justification.CENTER)
    if wrap:
        l.set_max_width_chars(chars)
    return l


def listbox(items):
    """A keyboard-friendly list: arrows to move, Enter or a double tap to go on; a tap only selects."""
    box = Gtk.ListBox(); box.set_selection_mode(Gtk.SelectionMode.BROWSE); box.set_activate_on_single_click(False)
    for key, text in items:
        row = Gtk.ListBoxRow(); row.key = key
        row.add(Gtk.Label(label=text, xalign=0)); box.add(row)
    sw = Gtk.ScrolledWindow(); sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); sw.add(box)
    sw.set_overlay_scrolling(False)   # a scrollbar always shown says "this list scrolls"
    return box, sw


def select(box, key):
    for row in box.get_children():
        if row.key == key:
            box.select_row(row); row.grab_focus(); return


def first_visible(box):
    """After a search: select the first row still shown, so Enter takes it."""
    for row in box.get_children():
        if row.get_child_visible():
            box.select_row(row); return


def osk_theme():
    """onboard's Nightshade theme with opaque pages: its 123 and symbols pages were 90 % opaque and showed the
    letters through. Written to the session user's own theme folder, where onboard looks for themes."""
    home = os.path.expanduser("~/.local/share/onboard/themes")
    src = "/usr/share/onboard/themes"
    try:
        os.makedirs(home, exist_ok=True)
        colors = open(f"{src}/Charcoal.colors").read().replace('name="Charcoal"', 'name="SmartPi"')
        colors = re.sub(r'(<layer>\s*<color element="background" rgb="#[0-9a-fA-F]+" opacity=")[0-9.]+"', r'\g<1>1.0"', colors)
        open(f"{home}/SmartPi.colors", "w").write(colors)
        theme = open(f"{src}/Nightshade.theme").read().replace('name="Nightshade"', 'name="SmartPi"')
        theme = theme.replace("<color_scheme>Charcoal</color_scheme>", "<color_scheme>SmartPi</color_scheme>")
        open(f"{home}/SmartPi.theme", "w").write(theme)
        return f"{home}/SmartPi.theme"
    except OSError:
        return None


def osk_layout():
    """onboard's Compact layout, built in /tmp from the installed one: Esc in place of the top-left key; letters
    and 123 pages only; without the hide/move keys and the mouse helpers (middle, right, double, drag, hover click)."""
    src, dst = "/usr/share/onboard/layouts", "/tmp/smartpi-osk"
    try:
        shutil.rmtree(dst, ignore_errors=True); shutil.copytree(src, dst)
        lay = open(f"{dst}/Compact.onboard").read()
        svg = open(f"{dst}/Compact-Alpha.svg").read()
        if lay.count('<key group="alphanumeric" id="TLDE"/>') != 1 or svg.count('id="TLDE"') != 1:
            return "Compact"
        lay = lay.replace('<key group="alphanumeric" id="TLDE"/>', '<key group="bottomrow" id="ESC"/>')
        lay = re.sub(r"""\s*<key group=["'](?:bottomrow|sidebar)["'] id=["'](?:hide|move|showclick|layer2)["'][^>]*/>""", "", lay)
        lay = re.sub(r'\s*<box orientation="horizontal" expand="false">\s*</box>', "", lay)
        lay = lay.replace('id="layer0" show_active="false"', 'id="layer0"')          # Abc shows as selected too
        lay = lay.replace("id='layer0' show_active=\"false\"", "id='layer0'")
        # 123 stays up after a key (arrows, digits) until Abc is pressed; onboard drops back to letters otherwise
        def stay(m):
            return re.sub(r"<key (?![^>]*unlatch_layer)", "<key unlatch_layer=\"false\" ", m.group(0))
        lay = re.sub(r'<panel layer="numbers".*?</panel>', stay, lay, flags=re.S)
        lay = re.sub(r'\s*<panel layer="utils".*?</panel>', "", lay, flags=re.S)        # 16 empty snippets, quit, settings
        lay = re.sub(r'\s*<panel id="click".*?</panel>', "", lay, flags=re.S)
        open(f"{dst}/Compact.onboard", "w").write(lay)
        open(f"{dst}/Compact-Alpha.svg", "w").write(svg.replace('id="TLDE"', 'id="ESC"'))
        return f"{dst}/Compact.onboard"
    except OSError:
        return "Compact"


