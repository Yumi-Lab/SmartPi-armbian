    # ---- checks: return an error text, or None to go on --------------------------------------------------
    def check_language(self):
        row = self.langs.get_selected_row()
        if not row or not row.get_child_visible():
            return self.t["lang_err"]
        self.set_language(row.key)

    def check_zone(self):
        row = self.zones.get_selected_row()
        if not row or not row.get_child_visible():
            return self.t["zone_err"]
        self.data["zone"] = row.key

    def check_user(self):
        name = self.user.get_text().strip()
        if not NAME.match(name) or name in RESERVED:
            return self.t["acc_err"]
        self.data["user"] = name
        for widget, key, kind in self.texts:   # the password pages name the account
            if "{user}" in self.t[key]:
                self.apply_text(widget, key, kind)

    def check_rpw1(self):
        if not self.rpw1.get_text():
            return self.t["pw_err"]
        self.data["root_password"] = self.rpw1.get_text()

    def check_rpw2(self):
        if self.rpw2.get_text() != self.data["root_password"]:
            self.rpw2.set_text("")
            return self.t["pw2_err"]

    def focus_realname(self):
        """Armbian offers the username with a capital as the real name: Enter keeps it."""
        if not self.realname.get_text():
            self.realname.set_text(self.data["user"].capitalize())
        self.realname.grab_focus(); self.realname.set_position(-1)

    def check_realname(self):
        self.data["realname"] = self.realname.get_text().strip() or self.data["user"].capitalize()
        self.data["autologin"] = self.autologin.get_active()

    def check_pw1(self):
        if not self.pw1.get_text():
            return self.t["pw_err"]
        self.data["password"] = self.pw1.get_text()

    def check_pw2(self):
        if self.pw2.get_text() != self.data["password"]:
            self.pw2.set_text("")
            return self.t["pw2_err"]

    def check_wifi(self):
        row = self.wifis.get_selected_row()
        if row is self.rescan:
            return self.t["wifi_err"]
        self.data["wifi"] = row.key if row else ""

    def check_wpw(self):
        self.data["wifi_password"] = self.wpw.get_text()

    # ---- navigation --------------------------------------------------------------------------------------
    def visible(self, i):
        name = self.pages[i]["name"]
        if name == "wifi":
            return self.has_wifi
        if name == "wifipw":
            return bool(self.data["wifi"])
        return name != "skip"

    def show_page(self, i, back=False):
        self.current = i
        self.stack.set_visible_child_name(self.pages[i]["name"])
        self.refresh_controls()
        self.fit_lists()
        if self.pages[i]["focus"]:
            self.pages[i]["focus"]()
        elif self.pages[i]["name"] != "apply":
            self.go.grab_focus()

    def say(self, text):
        self.error.set_text(text or ""); self.error.set_visible(bool(text))

    def next(self):
        if not hasattr(self, "current") or self.pages[self.current]["name"] == "apply":
            return
        if self.pages[self.current]["name"] == "skip":
            self.data["skip"] = True   # the pages still read the rest of the data while they redraw
            self.show_page(self.index("apply"))
            self.spinner.start(); threading.Thread(target=self.apply, daemon=True).start()
            return
        check = self.pages[self.current]["check"]
        err = check() if check else None
        self.say(err or "")
        if err:
            return
        i = self.current + 1
        while not self.visible(i):
            i += 1
        self.show_page(i)
        if self.pages[i]["name"] == "apply":
            self.spinner.start(); threading.Thread(target=self.apply, daemon=True).start()

    def index(self, name):
        return next(i for i, p in enumerate(self.pages) if p["name"] == name)

    def previous(self, skip=False):
        if self.pages[self.current]["name"] == "skip":
            self.show_page(0, back=True)
        elif self.current == 0 and skip:
            self.show_page(self.index("skip"))
        elif 0 < self.current and self.pages[self.current]["name"] != "apply":
            i = self.current - 1
            while i > 0 and not self.visible(i):
                i -= 1
            self.say(""); self.show_page(i, back=True)

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.previous()
            return True
        return False

    # ---- mouse, touch, on-screen keyboard ----------------------------------------------------------------
    def touch_screen(self):
        return bool(self.seat.get_slaves(Gdk.SeatCapabilities.TOUCH))

    def has_mouse(self):
        not_mice = ("xtest", "sunxi-ir", "gpio-keys", "keyboard", "consumer control")
        return self.touch_screen() or any(not any(w in d.get_name().lower() for w in not_mice)
                                          for d in self.seat.get_slaves(Gdk.SeatCapabilities.POINTER))

    def refresh_controls(self):
        self.on_screen_keyboard()
        if not hasattr(self, "current"):
            return
        last, first = self.pages[self.current]["name"] == "apply", self.current == 0
        skip = self.pages[self.current]["name"] == "skip"
        mouse = self.has_mouse()
        self.go.set_label(self.t["start"] if first else self.t["skip_go"] if skip else self.t["go"])
        self.back.set_label(self.t["skip"] if first else self.t["back"])
        self.go.set_visible(not last and (mouse or first or skip))
        self.back.set_visible(not last and (mouse or first or skip))
        self.hint.set_text("" if first else self.t["hint"] if mouse else self.t["hint_kbd"])
        self.hint.set_visible(not last and not first and not skip)
        shown = [j for j, p in enumerate(self.pages) if self.visible(j) and p["name"] != "apply"]
        self.step.set_text("" if last or first or skip else
                           self.t["step"].format(shown.index(self.current), len(shown) - 1))
        if self.pages[self.current]["name"] == "wifipw":
            self.pages[self.current]["title"].set_text(self.t["wpw"].format(self.data["wifi"]))

    def osk_geometry(self):
        """(xid, width, height) of onboard's keyboard window as X has it, or None while it is not on screen yet."""
        m = re.search(r'^\s*(0x[0-9a-f]+) "Onboard": .*?\s(\d+)x(\d+)[+-]', run("xwininfo", "-root", "-children"), re.M)
        if not m or not 60 < int(m.group(3)) < self.geo.height * 0.7:
            return None
        return int(m.group(1), 16), int(m.group(2)), int(m.group(3))

    def kb_height(self):
        """Height of the on-screen keyboard: asked as 38 % of the screen, onboard may keep its own proportions."""
        g = self.osk_geometry()
        return g[2] if g else int(self.geo.height * 0.38)

    def on_screen_keyboard(self):
        """A touch screen: open the image's on-screen keyboard (onboard), docked along the bottom, with a tab
        above it to fold it away and bring it back; the card shrinks to fit in the space left above."""
        if self.osk or not self.touch_screen() or not os.path.exists("/usr/bin/onboard"):
            return
        for schema, key, value in (("org.onboard", "show-tooltips", "false"), ("org.onboard.window", "docking-enabled", "false")):
            subprocess.run(["gsettings", "set", schema, key, value], capture_output=True)
        h = self.kb_height()
        theme = osk_theme()
        self.osk = subprocess.Popen(["onboard", f"--size={self.geo.width}x{h}", "-x", str(self.geo.x),
                                     "-y", str(self.geo.y + self.geo.height - h), f"--layout={osk_layout()}"]
                                    + ([f"--theme={theme}"] if theme else []))
        self.fold_keyboard(False)

    def round_tab(self, win, alloc):
        """Pill-shaped button window: cut its corners off (no compositor, so no transparent corners)."""
        w, h, r = alloc.width, alloc.height, alloc.height // 2
        region = cairo.Region()
        for y in range(h):
            dy = max(r - y - 0.5, y + 0.5 - (h - r), 0)
            inset = int(round(r - math.sqrt(max(r * r - dy * dy, 0)))) if dy else 0
            region.union(cairo.RectangleInt(inset, y, w - 2 * inset, 1))
        if win.get_window():
            win.get_window().shape_combine_region(region, 0, 0)

    def place(self, kb_top):
        """Keyboard top edge at kb_top: the keyboard window there, the button just above its right end."""
        self.osk_win.move(self.geo.x, kb_top)
        tw, th = self.tab.get_size()
        self.tab.move(self.geo.x + self.geo.width - tw - 24, kb_top - th - 10)

    def fold_keyboard(self, fold):
        """fold=True slides the on-screen keyboard down off the screen, False slides it back up; the button
        rides on it. The card is laid out once, before the keyboard comes up or after it went down."""
        win = self.osk_window()
        if not win:
            # onboard not on screen yet: try again shortly, once its real size is known
            GLib.timeout_add(400, lambda: self.fold_keyboard(fold) and False)
            return
        self.osk_open = not fold
        if not fold:
            try:   # onboard may have hidden itself: ask it to show (no-op when it is shown)
                Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
                                               "org.onboard.Onboard", "/org/onboard/Onboard/Keyboard",
                                               "org.onboard.Onboard.Keyboard", None).call(
                    "Show", None, Gio.DBusCallFlags.NONE, 2000, None, None, None)
            except GLib.Error:
                pass
        self.tab_icon.set_from_pixbuf(pixbuf(f"{ASSETS}/{'chevrons-up' if fold else 'chevrons-down'}.svg", 22))
        self.tab.show_all()
        bottom, kb = self.geo.y + self.geo.height, self.kb_height()
        start, end = (bottom - kb, bottom) if fold else (bottom, bottom - kb)
        if not fold:
            self.set_compact(True)
        frames, step = 8, [0]

        def tick():
            step[0] += 1
            k = 1 - (1 - step[0] / frames) ** 3               # ease out
            self.place(int(start + (end - start) * k))
            if step[0] < frames:
                return True
            if fold:
                self.set_compact(False)
            return False
        self.place(start); GLib.timeout_add(16, tick)

    def osk_window(self):
        """onboard's top-level X window, looked up once it is on screen."""
        if getattr(self, "osk_win", None):
            return self.osk_win
        g = self.osk_geometry()
        if g:
            self.osk_win = GdkX11.X11Window.foreign_new_for_display(Gdk.Display.get_default(), g[0])
        return getattr(self, "osk_win", None)

    def set_card_width(self, width):
        side = max(12, (self.geo.width - width) // 2)
        self.outer.set_margin_start(side); self.outer.set_margin_end(side)

    def set_compact(self, keyboard_open):
        """A docked keyboard (touch screen): the card takes its row layout and one fixed size that fits above the
        open keyboard, then only moves: up when the keyboard opens, centred when it is folded. Same fonts."""
        if not getattr(self, "rows", False):
            self.rows = True
            self.brand.set_orientation(Gtk.Orientation.HORIZONTAL); self.brand.set_spacing(14)
            for sw in (self.langs_sw, self.zones_sw, self.wifis_sw):
                sw.set_size_request(-1, 84)
        free = self.geo.height - (self.kb_height() if keyboard_open else 0)
        self.set_card_width(min(680, self.geo.width - 48))
        self.card.set_size_request(-1, min(free - 24, 680))
        self.outer.set_margin_bottom(self.geo.height - free)

    def stack_page_height(self, page):
        """Card height with the given page shown and its list folded (for one size that suits every page)."""
        shown = self.stack.get_visible_child_name()
        self.stack.set_visible_child_name(page["name"])
        h = self.card.get_preferred_height()[1]
        if shown:
            self.stack.set_visible_child_name(shown)
        return h

    def fit_lists(self):
        """Give the lists whatever height the screen leaves once the rest of the card is laid out, so a list
        always shows as many rows as fit. With a docked keyboard the card has a fixed size and its lists
        simply fill it."""
        if not hasattr(self, "free") or getattr(self, "rows", False):
            return
        lists = (self.langs_sw, self.zones_sw, self.wifis_sw)
        for sw in lists:
            sw.set_size_request(-1, 1)
        rest = max(self.stack_page_height(p) for p in self.pages) if getattr(self, "rows", False) else \
            self.card.get_preferred_height()[1]             # card height with the list folded
        room = self.free - rest - 24                         # 12 px of air above and below the card
        for sw in lists:
            sw.set_size_request(-1, max(84, min(360, room)))

    # ---- screen ------------------------------------------------------------------------------------------
    def show_pointer(self, show):
        """Arrow or no pointer at all, on every window of the session (ours, the keyboard, the background)."""
        if show == self.pointer_shown:
            return
        self.pointer_shown = show
        cursor = Gdk.Cursor.new_from_name(Gdk.Display.get_default(), "default" if show else "none")
        for win in (self.get_window(), self.tab.get_window(), Gdk.get_default_root_window(),
                    getattr(self, "osk_win", None)):
            if win:
                win.set_cursor(cursor)

    def on_pointer_event(self, _w, ev):
        device = ev.get_source_device()
        touch = device is not None and device.get_source() == Gdk.InputSource.TOUCHSCREEN
        kind = ev.get_event_type()
        if kind in (Gdk.EventType.TOUCH_BEGIN, Gdk.EventType.BUTTON_PRESS, Gdk.EventType.TOUCH_END,
                    Gdk.EventType.BUTTON_RELEASE) and touch:
            self.show_pointer(False)                       # a tap: no pointer
        elif kind in (Gdk.EventType.TOUCH_UPDATE, Gdk.EventType.MOTION_NOTIFY):
            state = ev.get_state()[1]                      # (has_state, state)
            pressed = kind == Gdk.EventType.TOUCH_UPDATE or bool(state & Gdk.ModifierType.BUTTON1_MASK)
            self.show_pointer(not touch or pressed)        # a mouse, or a finger sliding
        return False

    def on_map(self, *_):
        self.pointer_shown = None
        self.show_pointer(not self.touch_screen())
        # no window manager: take the keyboard explicitly, X would otherwise send keys under the pointer
        self.get_window().focus(Gdk.CURRENT_TIME)
        self.show_page(0)

    def on_monitors(self, *_):
        """Resolution changed (the HDMI hotplug handler owns the mode, this only follows it): cover the
        screen again, and start the on-screen keyboard again at the new size, with its tab on it."""
        g = Gdk.Display.get_default().get_monitor(0).get_geometry()
        if (g.width, g.height) != (self.geo.width, self.geo.height):
            self.geo = g; self.move(g.x, g.y); self.resize(g.width, g.height)
            if self.osk:
                self.osk.terminate(); self.osk.wait(); self.osk = None
                self.on_screen_keyboard()

    # ---- time zone and WiFi lists ------------------------------------------------------------------------
    def focus_lang(self):
        self.lsearch.set_text(""); self.lmatch = matcher(""); self.langs.invalidate_filter()
        select(self.langs, self.data["lang"]); self.lsearch.grab_focus()

    def on_lang_search(self, *_):
        self.lmatch = matcher(self.lsearch.get_text()); self.langs.invalidate_filter()
        first_visible(self.langs)

    def search_arrows(self, entry, ev, box):
        """Down arrow from a search box goes into its list."""
        if ev.keyval == Gdk.KEY_Down:
            row = box.get_selected_row()
            if row:
                row.grab_focus()
            return True
        return False

    def focus_zone(self):
        self.zsearch.set_text(""); self.zmatch = matcher(""); self.zones.invalidate_filter()
        select(self.zones, self.data["zone"])
        self.zsearch.grab_focus()

    def on_zone_search(self, *_):
        self.zmatch = matcher(self.zsearch.get_text()); self.zones.invalidate_filter()
        first_visible(self.zones)

    def on_wifi_row(self, _box, row):
        if row is self.rescan:
            if self.rescan_label.get_text() != self.t["wifi_searching"]:
                self.rescan_label.set_text(self.t["wifi_searching"])
                threading.Thread(target=self.scan_wifi, daemon=True).start()
        else:
            self.next()

    def scan_wifi(self):
        seen = []
        for ssid in run("nmcli", "-t", "-f", "SSID", "device", "wifi", "list", "--rescan", "yes").splitlines():
            ssid = ssid.replace("\\:", ":")
            if ssid and ssid not in seen:
                seen.append(ssid)
        self.networks = seen
        GLib.idle_add(self.fill_wifi)

    def fill_wifi(self):
        for row in self.wifis.get_children():
            if row not in (self.no_wifi, self.rescan):
                self.wifis.remove(row)
        self.rescan_label.set_text(self.t["wifi_again"])
        for ssid in self.networks:
            row = Gtk.ListBoxRow(); row.key = ssid; row.add(Gtk.Label(label=ssid, xalign=0))
            self.wifis.insert(row, len(self.wifis.get_children()) - 1)
        self.wifis.show_all()
        return False

    def focus_wifi(self):
        select(self.wifis, self.data["wifi"])

    def focus_wpw(self):
        self.wpw.grab_focus()

    # ---- apply -------------------------------------------------------------------------------------------
    def apply(self):
        r = subprocess.run(["sudo", "-n", "/usr/local/sbin/smartpi-firstboot-apply"], input=json.dumps(self.data),
                           capture_output=True, text=True)
        GLib.idle_add(self.applied, r.returncode, (r.stdout + r.stderr).strip())

    def applied(self, code, out):
        self.spinner.stop()
        if code != 0:
            self.say(out[-300:] or self.t["failed"])
            self.show_page(self.index("account"), back=True)
        return False


Wizard().show_all()
Gtk.main()
