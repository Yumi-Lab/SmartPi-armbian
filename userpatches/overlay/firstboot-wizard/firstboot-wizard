    # ---- language ----------------------------------------------------------------------------------------
    def tr(self, widget, key, kind="label"):
        """Remember a widget whose text comes from TEXT[key], so a language change redoes it."""
        self.texts.append((widget, key, kind)); self.apply_text(widget, key, kind)
        return widget

    def apply_text(self, widget, key, kind):
        text = self.t[key].replace("{user}", self.data.get("user") or "")
        if kind == "label":
            widget.set_text(text)
        elif kind == "placeholder":
            widget.set_placeholder_text(text)
        elif kind == "tooltip":
            widget.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY, text)
        elif kind == "markup":
            widget.set_markup(emphasis(text))

    def refresh_autologin(self):
        self.autologin.set_label(self.t["yes" if self.autologin.get_active() else "no"])

    def set_language(self, lang_id):
        lid, _, layout, loc, zone, ui = LANG[lang_id]
        self.data.update(lang=lid, layout=layout, locale=loc, zone=zone)
        lay, _, variant = layout.partition(":")
        subprocess.run(["setxkbmap", "-layout", lay] + (["-variant", variant] if variant else []))
        if TEXT[ui] is not self.t:
            self.t = TEXT[ui]
            for widget, key, kind in self.texts:
                self.apply_text(widget, key, kind)
            self.refresh_autologin()
            if hasattr(self, "current"):
                self.refresh_controls()

    # ---- pages -------------------------------------------------------------------------------------------
    def page(self, name, title, subtitle, widget=None, focus=None, check=None, fill=False, help=None):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_valign(Gtk.Align.FILL if fill else Gtk.Align.CENTER)
        t = None
        if title or subtitle:   # list pages have none: their search field says what they are
            head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); head.set_halign(Gtk.Align.CENTER)
            t = label("", "title", wrap=True); head.pack_start(t, False, False, 0)
            if title:
                self.tr(t, title)
            if subtitle:
                s = self.tr(label("", "subtitle", wrap=True, chars=40), subtitle); s.set_valign(Gtk.Align.CENTER)
                head.pack_start(s, False, False, 0)
            box.pack_start(head, False, False, 0); self.heads.append(head)
        if widget:
            box.pack_start(widget, fill, fill, 8)
        if help:   # the rule for what to type, right under the field
            h = self.tr(label("", "help", wrap=True, chars=46), help); h.set_halign(Gtk.Align.START)
            box.pack_start(h, False, False, 0)
        self.stack.add_named(box, name)
        self.pages.append({"name": name, "focus": focus, "check": check, "title": t})

    def ghost(self, field, key):
        """Grey text inside a search field saying what it searches, until the first letter is typed. GTK's own
        placeholder hides as soon as the field has the cursor, and these fields get it from the start."""
        over = Gtk.Overlay(); over.add(field)
        hint = self.tr(label("", "ghost"), key); hint.set_halign(Gtk.Align.START); hint.set_margin_start(36)
        over.add_overlay(hint); over.set_overlay_pass_through(hint, True)
        field.connect("changed", lambda f: hint.set_opacity(0 if f.get_text() else 1))
        return over

    def entry(self, placeholder, secret=False):
        e = Gtk.Entry(visibility=not secret)
        if placeholder:
            self.tr(e, placeholder, "placeholder")
        e.connect("activate", lambda *_: self.next())
        if secret:   # eye to show what was typed
            e.set_icon_from_pixbuf(Gtk.EntryIconPosition.SECONDARY, pixbuf(f"{ASSETS}/eye.svg", 18))
            self.tr(e, "show", "tooltip")
            e.connect("icon-press", self.toggle_secret)
        return e

    def toggle_secret(self, e, *_):
        e.set_visibility(not e.get_visibility())
        e.set_icon_from_pixbuf(Gtk.EntryIconPosition.SECONDARY,
                               pixbuf(f"{ASSETS}/{'eye-off' if e.get_visibility() else 'eye'}.svg", 18))

