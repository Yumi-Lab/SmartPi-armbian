def plain(s):
    """lowercase without accents, so "fra", "Fra" and "fra" all find "Français"."""
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if unicodedata.category(c) != "Mn")


def matcher(query):
    """Search box text -> test on a string. Every word typed must be found, in any order ("eur pa" finds
    Europe/Paris, "fr sui" Français (Suisse)); each word is a regular expression when it is one (^ber,
    paris|lyon), plain text otherwise; case and accents ignored."""
    words = []
    for w in plain(query).split():
        try:
            words.append(re.compile(w))
        except re.error:
            words.append(re.compile(re.escape(w)))
    return lambda s: all(rx.search(plain(s)) for rx in words)

