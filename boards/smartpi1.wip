# Allwinner H3 quad core 1Gb SoC
BOARD_NAME="SmartPi One"
BOARDFAMILY="sun8i"
BOOTCONFIG="smartpi1_defconfig"
MODULES_LEGACY="g_ncm"
MODULES_CURRENT="g_ncm"
SERIALCON="ttyS0"
KERNEL_TARGET="legacy,current,edge"

# 8188eu driver so RTL8188EUS dongles can run as an access point (userpatches/extensions/).
enable_extension "rtl8188eu-ap"
# AIC8800 USB WiFi 6 + Bluetooth dongles work as soon as they are plugged in (userpatches/extensions/).
enable_extension "aic8800-usb"

# USB WiFi and Bluetooth dongles: every driver the kernel has, as modules that
# load only when such a dongle is plugged in. Armbian's sunxi config leaves out:
# - rtw88 8812AU/8821AU/8814AU: Armbian builds Realtek's out-of-tree 8812au
#   driver into kernels older than 6.17 only, so on 6.18 these dongles showed
#   up in lsusb with no interface;
# - rtw89 8851BU/8852BU (Realtek WiFi 6) and mt7925u (MediaTek WiFi 7);
# - btusb's MediaTek support, the Bluetooth half of MediaTek WiFi 6/7 dongles.
# Left out on purpose: Broadcom USB and ZyDAS ZD1211, whose firmware is not in
# linux-firmware.
function custom_kernel_config__smartpi1_usb_wifi_bt() {
	declare -a wifi=(RTW89 RTW89_8851BU RTW89_8852BU MT7925U)
	linux-version compare "${KERNEL_MAJOR_MINOR}" ge 6.17 && wifi+=(RTW88_8812AU RTW88_8821AU RTW88_8814AU)
	kernel_config_modifying_hashes+=("usb_wifi_bt=${wifi[*]} BT_HCIBTUSB_MTK")
	[[ ! -f .config ]] && return 0
	declare opt
	for opt in "${wifi[@]}"; do
		kernel_config_set_m "CONFIG_${opt}"
	done
	kernel_config_set_y CONFIG_BT_HCIBTUSB_MTK
}

# ...and their firmware. armbian-firmware is a subset of linux-firmware that
# leaves out common dongles (AR9271, MT7610U, RTL8188FTV, RTL8761BU Bluetooth):
# the module loads and the dongle stays dead. Every file that a USB WiFi or
# Bluetooth module asks for (modinfo, including the chip and helper modules it
# pulls in, btrtl under btusb for instance) and the image lacks is taken from a
# pinned linux-firmware release, so the list follows the kernel. Names that
# linux-firmware only declares as links (WHENCE) become links to their target.
declare -g SMARTPI_LINUX_FIRMWARE_TAG="20260916"
function post_family_tweaks__smartpi1_usb_dongle_firmware() {
	declare url="https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain"
	declare cache="${SRC}/cache/linux-firmware-${SMARTPI_LINUX_FIRMWARE_TAG}"
	declare -a wanted=()
	mapfile -t wanted < <(chroot "${SDCARD}" /bin/bash -s <<- 'LIST'
		for k in /lib/modules/*; do
			k=${k##*/}
			for m in $(find /lib/modules/$k/kernel/drivers/net/wireless /lib/modules/$k/kernel/drivers/bluetooth -name '*.ko*'); do
				modinfo -F alias "$m" | grep -q '^usb:' && modprobe -S "$k" -D "$(modinfo -F name "$m")" | awk '/^insmod/ {print $2}'
			done
		done | sort -u | while read -r m; do modinfo -F firmware "$m"; done | sort -u | while read -r f; do
			[ -e "/lib/firmware/$f" ] || [ -e "/lib/firmware/$f.zst" ] || [ -e "/lib/firmware/$f.xz" ] || echo "$f"
		done
	LIST
	)
	mkdir -p "${cache}"
	[[ -s "${cache}/WHENCE" ]] || wget --quiet --tries=3 -O "${cache}/WHENCE" "${url}/WHENCE?h=${SMARTPI_LINUX_FIRMWARE_TAG}" ||
		exit_with_error "USB dongle firmware" "could not download linux-firmware ${SMARTPI_LINUX_FIRMWARE_TAG} WHENCE"
	declare f file target added=0 absent=0
	for f in "${wanted[@]}"; do
		target=$(awk -v f="${f}" '$1 == "Link:" && $2 == f {print $4}' "${cache}/WHENCE")
		file="${f}"
		[[ -n "${target}" ]] && file="$(dirname "${f}")/${target}"
		if [[ ! -e "${SDCARD}/lib/firmware/${file}" ]]; then
			if [[ ! -s "${cache}/${file}" ]]; then
				mkdir -p "$(dirname "${cache}/${file}")"
				wget --quiet --tries=3 -O "${cache}/${file}.tmp" "${url}/${file}?h=${SMARTPI_LINUX_FIRMWARE_TAG}" && mv "${cache}/${file}.tmp" "${cache}/${file}" ||
					{ rm -f "${cache}/${file}.tmp"; absent=$((absent + 1)); continue; }
			fi
			install -D -m 644 "${cache}/${file}" "${SDCARD}/lib/firmware/${file}"
		fi
		[[ -n "${target}" ]] && ln -sf "${target}" "${SDCARD}/lib/firmware/${f}"
		added=$((added + 1))
	done
	display_alert "USB WiFi/Bluetooth firmware" "${added} added from linux-firmware ${SMARTPI_LINUX_FIRMWARE_TAG}, ${absent} not published there" "info"
}

# Replace U-Boot's built-in logo with the Yumi one. It is drawn the instant the
# video device is probed — before any file is read from the SD card — so it
# appears immediately, unlike /boot/boot.bmp which the boot script displays
# once it has been loaded.
# The blob linked into the binary is drivers/video/u_boot_logo.bmp (see
# obj-$(CONFIG_VIDEO_LOGO) in drivers/video/Makefile); tools/logos/ only feeds
# the legacy bmp_logo tool, so overwriting it alone changes nothing.
function pre_config_uboot_target__smartpi1_yumi_logo() {
	declare logo="${SRC}/userpatches/overlay/u-boot-logo.bmp"
	[[ -f "${logo}" ]] || { display_alert "u-boot for ${BOARD}" "Yumi logo not found, keeping the default" "wrn"; return 0; }
	display_alert "u-boot for ${BOARD}" "installing the Yumi boot logo" "info"
	run_host_command_logged cp -v "${logo}" drivers/video/u_boot_logo.bmp
	run_host_command_logged cp -v "${logo}" tools/logos/u-boot_logo.bmp
}

# A damaged /boot must not stop the boot. Armbian lists the FAT partition in
# fstab with a fsck pass and without nofail, so when fsck.fat gives up systemd
# drops to emergency mode even though the kernel and initramfs it needed were
# already loaded from that very partition. FAT has no journal and /boot is
# written at run time (kernel and initramfs updates, armbian-firstrun,
# smartpi-oc), so a power cut can leave it dirty.
# nofail alone also drops the mount's ordering before local-fs.target
# (systemd.mount): services that read /boot could then start before it is
# mounted (seen on hardware: local-fs.target at 7.3 s, /boot at 9.5 s).
# x-systemd.before=local-fs.target keeps the order without making the boot
# depend on the mount succeeding.
# Done on the final image: /etc/fstab does not exist yet when
# customize-image.sh runs (prepare_partitions comes after customize_image).
function pre_umount_final_image__smartpi1_boot_nofail() {
	display_alert "fstab for ${BOARD}" "mount /boot with nofail, still before local-fs.target" "info"
	sed -i '/[[:space:]]\/boot[[:space:]]/ s/defaults/defaults,nofail,x-systemd.before=local-fs.target/' "${MOUNT}/etc/fstab"
	run_host_command_logged grep /boot "${MOUNT}/etc/fstab"
}

# Armbian puts every ext4 root in data=writeback (tune2fs in its partitioning.sh)
# and leaves errors=continue in the superblock. After a power cut, writeback
# lets a file written just before come back filled with stale blocks
# (printer.cfg, dpkg status), and continue keeps writing on a corrupted
# structure. Fixed in the superblock rather than on the kernel command line so
# it survives anyone rewriting extraargs or fstab (the DietPi installer does
# both). Runs after the final unmount, while the loop device is still attached;
# the root is the second partition on this board (FAT /boot first). A wrong
# partition would make tune2fs fail loudly on a bad superblock magic.
function post_umount_final_image__smartpi1_ext4_ordered() {
	display_alert "ext4 root for ${BOARD}" "data=ordered, errors=remount-ro in the superblock" "info"
	run_host_command_logged tune2fs -o ^journal_data_writeback -e remount-ro "${LOOP}p2"
	run_host_command_logged dumpe2fs -h "${LOOP}p2" "|" grep -E "'Default mount options|Errors behavior'"
}

# Armbian tags the boot partition as MBR type 0xEA (Linux extended boot,
# partitioning.sh) even when it is FAT, and Windows and macOS refuse to mount
# a partition of that type: from a computer the card shows no boot partition
# at all, so the cloud-init files (WiFi, user), armbianEnv.txt and
# yumi-boot.log cannot be read or edited, and Raspberry Pi Imager cannot write
# its customization. Retag it as FAT32 LBA (0x0C), the type of every Raspberry
# Pi OS image. U-Boot loads from the partition number, not the type: the DietPi
# images built from this one have carried 0x0C since July and boot.
function post_umount_final_image__smartpi1_boot_fat_type() {
	[[ "${BOOTFS_TYPE}" == "fat" ]] || return 0
	display_alert "boot partition for ${BOARD}" "MBR type 0x0C (FAT32 LBA), visible on Windows and macOS" "info"
	run_host_command_logged sfdisk --no-reread --no-tell-kernel --part-type "${LOOP}" 1 c
	run_host_command_logged sfdisk --part-type "${LOOP}" 1
}
